# Copy this file to .env and fill in the values. .env is gitignored. Never commit real values.
# Cloudflare R2 (S3-compatible). Token must be scoped to the nba-bucket bucket only.
R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nba-bucket
