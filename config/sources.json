{
  "repo": "sportsdataverse/sportsdataverse-data",
  "r2_prefix": "raw/hoopr_stats",
  "seasons": [
    2022,
    2023,
    2024,
    2025,
    2026,
    2027
  ],
  "tiers": {
    "tier1": [
      "nba_stats_player_boxscores",
      "nba_stats_team_boxscores",
      "nba_stats_schedules",
      "nba_stats_injury_report"
    ],
    "tier2": [
      "nba_stats_pbp",
      "nba_stats_shots",
      "nba_stats_possessions",
      "nba_stats_lineups",
      "nba_stats_game_lineups",
      "nba_stats_player_season_stats",
      "nba_stats_team_season_stats",
      "nba_stats_game_rosters",
      "nba_stats_standings",
      "nba_stats_rosters",
      "nba_stats_officials"
    ]
  },
  "bronze": {
    "warehouse_id": "22203161b15e3ce0",
    "schema": "workspace.nba_v2_bronze",
    "tables": {
      "nba_stats_player_boxscores": {
        "table": "player_boxscores",
        "key": [
          "game_id",
          "person_id"
        ]
      },
      "nba_stats_team_boxscores": {
        "table": "team_boxscores",
        "key": [
          "game_id",
          "team_id",
          "side"
        ]
      },
      "nba_stats_schedules": {
        "table": "schedules",
        "key": [
          "game_id"
        ]
      },
      "nba_stats_injury_report": {
        "table": "injury_report"
      },
      "nba_stats_pbp": {
        "table": "pbp",
        "key": [
          "game_id",
          "order_index"
        ]
      },
      "nba_stats_shots": {
        "table": "shots"
      },
      "nba_stats_possessions": {
        "table": "possessions",
        "key": [
          "game_id",
          "possession_number"
        ]
      },
      "nba_stats_game_lineups": {
        "table": "game_lineups"
      },
      "nba_stats_game_rosters": {
        "table": "game_rosters",
        "key": [
          "game_id",
          "player_id"
        ]
      },
      "nba_stats_officials": {
        "table": "officials",
        "key": [
          "game_id",
          "official_id"
        ]
      },
      "nba_stats_lineups": {
        "table": "lineups",
        "mode": "append",
        "key": [
          "group_id",
          "team_id",
          "season_type",
          "measure_type",
          "per_mode"
        ]
      },
      "nba_stats_player_season_stats": {
        "table": "player_season_stats",
        "mode": "append",
        "key": [
          "player_id",
          "team_id",
          "season_type",
          "measure_type",
          "per_mode"
        ]
      },
      "nba_stats_team_season_stats": {
        "table": "team_season_stats",
        "mode": "append",
        "key": [
          "team_id",
          "season_type",
          "measure_type",
          "per_mode"
        ]
      },
      "nba_stats_standings": {
        "table": "standings",
        "mode": "append",
        "key": [
          "team_id",
          "season_type"
        ]
      },
      "nba_stats_rosters": {
        "table": "rosters",
        "mode": "append",
        "key": [
          "team_id",
          "player_id"
        ]
      }
    }
  }
}
